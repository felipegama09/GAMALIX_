<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="40dp">

        <ImageView
            android:layout_width="200dp"
            android:layout_height="112dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:contentDescription="GamaFlix"
            android:scaleType="fitCenter"
            android:src="@drawable/gamaflix_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"
            android:text="VOD, filmes e séries na sua lista"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabXtream"
                style="@style/TabText"
                android:text="Xtream Codes" />

            <TextView
                android:id="@+id/tabM3u"
                style="@style/TabText"
                android:text="Lista M3U" />
        </LinearLayout>

        <EditText
            android:id="@+id/etServer"
            style="@style/Field"
            android:hint="Servidor (ex.: http://exemplo.com:8080)"
            android:imeOptions="actionNext" />

        <EditText
            android:id="@+id/etUser"
            style="@style/Field"
            android:hint="Usuário"
            android:imeOptions="actionNext"
            android:inputType="text" />

        <EditText
            android:id="@+id/etPass"
            style="@style/Field"
            android:hint="Senha"
            android:imeOptions="actionDone"
            android:inputType="textPassword" />

        <TextView
            android:id="@+id/btnEnter"
            style="@style/TabText"
            android:layout_width="match_parent"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="0dp"
            android:text="Entrar"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
